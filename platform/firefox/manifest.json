{
	"manifest_version": 3,
	"name": "Curt Conversation Exporter",
	"version": "0.1.0",
	"description": "Export live AI chat conversations to the open .curt format.",
	"browser_specific_settings": {
		"gecko": {
			"id": "curt-webext@curt.fyi",
			"strict_min_version": "115.0",
			"data_collection_permissions": {
				"required": ["none"]
			}
		}
	},
	"permissions": ["activeTab", "downloads"],
	"icons": {
		"16": "platform/icons/icon16.png",
		"32": "platform/icons/icon32.png",
		"48": "platform/icons/icon48.png",
		"128": "platform/icons/icon128.png"
	},
	"host_permissions": ["https://claude.ai/*", "https://chatgpt.com/*"],
	"action": {
		"default_popup": "src/ui/popup.html",
		"default_title": "Export conversation as .curt",
		"default_icon": {
			"16": "platform/icons/icon16.png",
			"32": "platform/icons/icon32.png",
			"48": "platform/icons/icon48.png"
		}
	},
	"content_scripts": [
		{
			"matches": ["https://claude.ai/*"],
			"js": ["src/adapters/claude/content.js"],
			"run_at": "document_idle"
		},
		{
			"matches": ["https://chatgpt.com/*"],
			"js": ["src/adapters/chatgpt/content.js"],
			"run_at": "document_idle"
		}
	]
}
